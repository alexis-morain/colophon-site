---
import type { Copy } from "../copy";
import { config } from "../copy";
import Spread from "../components/Spread.astro";
import "../styles/global.css";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;

// The three labels inside the diagram, kept here rather than in copy.ts:
// they belong to the drawing, not to the argument.
const diagram =
  copy.lang === "fr"
    ? { trim: "Taille rognée", bleed: "fond perdu 3 mm", fold: "pli" }
    : { trim: "Trim size", bleed: "3 mm bleed", fold: "fold" };

// Every internal link goes through here: `base` is the one place that knows
// where the site sits, and hard-coded absolute paths would break the day it moves.
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
const url = (path: string) => `${root}${path}`;

// Which landscape thumbnails illustrate each discard reason, in the order of
// `copy.sort.reasons`. Landscapes only: no face of the test set goes public.
const thumbs = [[9, 13, 5, 12], [3, 2], [7, 1], [6], [8]];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alt = new URL(url(copy.altHref), Astro.site).href;
---

<!doctype html>
<html lang={copy.lang} dir={copy.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={copy.lang === "en" ? "fr" : "en"} href={alt} />
    <!-- The app's own icon, the 32 px file from src-tauri/icons, byte for byte. -->
    <link rel="icon" href={url("/favicon.png")} type="image/png" sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={copy.lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- The same 1280 × 640 image as the repository's social preview. -->
    <meta property="og:image" content={new URL(url("/social.png"), Astro.site).href} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={copy.meta.imageAlt} />
  </head>

  <body>
    <a class="skip" href="#main">{copy.lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>

    <div class="wrap">
      <header class="masthead">
        <a class="mark" href={url(copy.lang === "fr" ? "/fr/" : "/")}><i aria-hidden="true"></i>Booklibre</a>
        <nav aria-label="Sections">
          <a href="#work">{copy.nav.work}</a>
          <a href="#promise">{copy.nav.promise}</a>
          <a href="#print">{copy.nav.print}</a>
          <a href="#faq">{copy.nav.faq}</a>
          <a class="lang" href={url(copy.altHref)} title={copy.altTitle} hreflang={copy.lang === "en" ? "fr" : "en"}>
            {copy.altLabel}
          </a>
        </nav>
        <a class="btn btn-sm" href="#get">{copy.hero.cta}</a>
      </header>
    </div>

    <main id="main">
      <div class="wrap">
        <div class="hero hero-split rise">
          <div>
            <h1 set:html={copy.hero.title} />
            <p class="lede">{copy.hero.lede}</p>
            <div class="actions">
              <a class="btn btn-lg" href="#get">{copy.hero.cta}</a>
              <a class="btn-quiet" href={config.repo}>{copy.hero.ctaAlt}</a>
            </div>
          </div>
          <dl class="props">
            {
              copy.hero.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.tag ? <span class="tag">{f.value}</span> : f.value}</dd>
                </div>
              ))
            }
            <div>
              <dt>Version</dt>
              <dd class="typed">{config.version}</dd>
            </div>
          </dl>
        </div>

        <figure class="shot shot-hero">
          <div class="table">
            <img src={url("/images/bilan.webp")} alt={copy.run.shot} width="1600" height="945" decoding="async" />
          </div>
          <figcaption>{copy.run.caption}</figcaption>
        </figure>
      </div>

      <!-- one run, in numbers -->
      <section id="work">
        <div class="wrap split">
          <div>
            <p class="kicker">{copy.run.kicker}</p>
            <p class="run">
              <b class="typed">{copy.run.from.n}</b> {copy.run.from.label}, <b class="typed">{copy.run.to.n}</b> {copy.run.to.label}{" "}
              <span set:html={copy.run.tail} />
            </p>
            <ol class="pipeline">
              {copy.run.pipeline.map((step) => <li>{step}</li>)}
            </ol>
          </div>
          <aside>
            <Spread trim={diagram.trim} bleed={diagram.bleed} fold={diagram.fold} />
            <p class="caption">{copy.sort.figure}</p>
          </aside>
        </div>
      </section>

      <!-- the sort view -->
      <section id="sort">
        <div class="wrap split">
          <div>
            <p class="kicker">{copy.sort.kicker}</p>
            <h2>{copy.sort.title}</h2>
            {copy.sort.body.map((para) => <p>{para}</p>)}
          </div>
          <div class="db" role="table" aria-label={copy.sort.title}>
            <div class="db-row db-head" role="row">
              <span role="columnheader">{copy.sort.reasonsHead[0]}</span>
              <span role="columnheader">{copy.sort.reasonsHead[1]}</span>
            </div>
            {
              copy.sort.reasons.map((reason, i) => (
                <div class="db-row" role="row">
                  <span role="cell">{reason}</span>
                  <span role="cell" class="thumbs">
                    {thumbs[i].map((n) => (
                      <img src={url(`/images/tri/t${n}.webp`)} alt="" width="48" height="36" />
                    ))}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="wrap">
          <figure class="shot">
            <div class="table">
              <img src={url("/images/tri.webp")} alt={copy.sort.shot} width="1600" height="945" loading="lazy" decoding="async" />
            </div>
          </figure>
        </div>
      </section>

      <!-- what it refuses to do -->
      <section id="promise">
        <div class="wrap split">
          <div>
            <p class="kicker">{copy.promise.kicker}</p>
            <h2>{copy.promise.title}</h2>
            <p>{copy.promise.lede}</p>
            <ul class="nevers">
              {
                copy.promise.items.map((item) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
          <aside class="callout">
            <p>{copy.promise.tail}</p>
          </aside>
        </div>
      </section>

      <!-- printing -->
      <section id="print">
        <div class="wrap split">
          <div>
            <p class="kicker">{copy.print.kicker}</p>
            <h2>{copy.print.title}</h2>
            {copy.print.body.map((para) => <p>{para}</p>)}
            <pre class="term"><code>{copy.print.code}</code></pre>
          </div>
          <aside>
            <dl class="props">
              {
                copy.print.checks.map((c) => (
                  <div>
                    <dt>{c.label}</dt>
                    <dd><span class={`tag tag-${c.tone}`}>{c.value}</span></dd>
                  </div>
                ))
              }
            </dl>
            <p class="caption">{copy.print.profiles}</p>
          </aside>
        </div>
      </section>

      <!-- what it does not do -->
      <section id="privacy">
        <div class="wrap">
          <div class="quiet-block">
            <p class="kicker">{copy.privacy.kicker}</p>
            <h2>{copy.privacy.title}</h2>
            <div class="cols">
              {copy.privacy.body.map((para) => <p>{para}</p>)}
            </div>
          </div>
        </div>
      </section>

      <!-- questions -->
      <section id="faq">
        <div class="wrap">
          <p class="kicker">{copy.faq.kicker}</p>
          <h2>{copy.faq.title}</h2>
          <div class="toggles">
            {
              copy.faq.items.map((item, i) => (
                <details open={i === 0}>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- get it -->
      <section id="get" class="get">
        <div class="wrap get-in">
          {
            config.released ? (
              <>
                <div>
                  <h2>{"Booklibre " + config.version}</h2>
                  <p>{copy.download.releasedLede}</p>
                  <p class="caption">{copy.download.linux}</p>
                </div>
                <div class="platforms">
                  <a class="btn btn-lg" href={config.releases}>{copy.download.mac}</a>
                  <a class="btn btn-second" href={config.releases}>{copy.download.win}</a>
                  <a class="btn-quiet" href={config.repo}>{copy.download.source}</a>
                </div>
              </>
            ) : (
              <>
                <div>
                  <h2>{copy.download.title}</h2>
                  <p>{copy.download.unreleasedLede}</p>
                  <ol class="steps">
                    {copy.download.unreleasedSteps.map((step) => (
                      <li>
                        <pre class="term"><code>{step.code}</code></pre>
                        <p class="caption">{step.note}</p>
                      </li>
                    ))}
                  </ol>
                </div>
                <div class="platforms">
                  <a class="btn btn-lg" href={config.repo}>{copy.download.source}</a>
                </div>
              </>
            )
          }
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-top">
          <span class="mark"><i aria-hidden="true"></i>{copy.foot.title}</span>
          <ul class="foot-links">
            {copy.foot.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <p>{copy.foot.body}</p>
        <p>{copy.foot.legal}</p>
      </div>
    </footer>
  </body>
</html>
